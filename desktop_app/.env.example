# Copy to .env when configuring the desktop application.

# Required for AI extraction.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional ERPNext export settings.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Purchase voucher ledger/account defaults.
PURCHASE_LEDGER_NAME=Purchase Account
INPUT_CGST_LEDGER_NAME=Input CGST
INPUT_SGST_LEDGER_NAME=Input SGST
INPUT_IGST_LEDGER_NAME=Input IGST
INPUT_CESS_LEDGER_NAME=Input CESS

# Optional local TallyPrime direct-posting settings.
TALLY_URL=http://localhost:9000
TALLY_COMPANY=
TALLY_TIMEOUT_SECONDS=20
TALLY_VENDOR_PARENT_LEDGER=Sundry Creditors
DEFAULT_STOCK_GROUP=Primary

ERPNEXT_PURCHASE_ACCOUNT=Purchase Account
ERPNEXT_CGST_ACCOUNT=Input CGST
ERPNEXT_SGST_ACCOUNT=Input SGST
ERPNEXT_IGST_ACCOUNT=Input IGST
ERPNEXT_CESS_ACCOUNT=Input CESS

# Optional runtime overrides.
# By default runtime files are stored under the OS app-data directory.
DESKTOP_RUNTIME_DIR=
DESKTOP_DATABASE_URL=

# Processing and validation settings.
MAX_FILE_SIZE_MB=10
DUPLICATE_CHECK_ENABLED=true
PDF_TABLE_EXTRACTION_ENABLED=true
MIN_CONFIDENCE_SCORE=0.7
MATH_TOLERANCE=2.0
CURRENCY_DECIMAL_PLACES=2
EWAY_BILL_THRESHOLD=50000.0
